# Embedding backend: bm25 (default, zero-dep Okapi BM25) | tfidf | sbert | anthropic
EMBEDDING_BACKEND=bm25

# Only needed for `cli.py ask` (always Anthropic) and `cli.py generate` (pluggable, see below)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Which provider `cli.py generate` uses: anthropic | openai | azure (override per-run with --provider)
LLM_PROVIDER=anthropic

# OpenAI, or any OpenAI-compatible /chat/completions provider (Groq, Together, Ollama, ...) --
# set OPENAI_BASE_URL to point at a non-OpenAI endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# Azure AI Foundry (Azure-OpenAI-compatible route on an AIServices resource). AZURE_AI_ENDPOINT
# can be the resource root or a full ".../api/projects/<project>" endpoint (the latter is
# normalized automatically). AZURE_AI_MODEL is the deployment name.
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_MODEL=gpt-4o
AZURE_AI_API_VERSION=2024-12-01-preview

# Optional retrieval tuning
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=5
