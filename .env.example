# Embedding backend: tfidf (default, zero-dep) | sbert | anthropic
EMBEDDING_BACKEND=tfidf

# Only needed for `cli.py ask` (always Anthropic) and `cli.py generate` (pluggable, see below)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Which provider `cli.py generate` uses: anthropic | openai (override per-run with --provider)
LLM_PROVIDER=anthropic

# OpenAI, or any OpenAI-compatible /chat/completions provider (Groq, Together, Ollama, ...) --
# set OPENAI_BASE_URL to point at a non-OpenAI endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# Optional retrieval tuning
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=5
